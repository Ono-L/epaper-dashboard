# 通知受信 API の認証キー（任意の安全な文字列に変更してください）
API_KEY=change-me-local-dev-key

# 天気取得の緯度・経度（初期値: 東京）
WEATHER_LATITUDE=35.6895
WEATHER_LONGITUDE=139.6917
WEATHER_LOCATION_NAME=東京

# タイムゾーン
TIMEZONE=Asia/Tokyo

# ディスプレイ出力モード（mock | waveshare）
DISPLAY_MODE=mock

# モックモード時の画像出力先
OUTPUT_IMAGE_PATH=output/preview.png

# 通知永続化用の SQLite DB パス
DB_PATH=data/notifications.db

# 日本語フォントパス（空の場合はシステム内から自動検出）
FONT_PATH=

# 画面に表示する通知の最大件数
MAX_DISPLAY_NOTIFICATIONS=5

# DB に保持する通知の最大件数
MAX_STORED_NOTIFICATIONS=50

# 天気キャッシュ秒数
WEATHER_CACHE_SECONDS=600
